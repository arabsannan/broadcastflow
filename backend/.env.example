# Copy this file to .env and fill in your own values.

# Local Chrome profile so you don't have to re-scan the WhatsApp Web QR
# code every time you restart the server.
# Windows example: C:\Users\<you>\AppData\Local\Google\Chrome\User Data
# Mac example:      /Users/<you>/Library/Application Support/Google/Chrome
CHROME_PROFILE_PATH=

# Set to "false" the first time you run the app so you can see the
# browser window and scan the QR code. Once WhatsApp Web is linked to
# the Chrome profile above, you can switch this to "true".
WHATSAPP_HEADLESS=false

# Delay (seconds) between messages to avoid tripping WhatsApp's spam
# detection. Keep this conservative.
MESSAGE_DELAY_SECONDS=3

# CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
